# 이 파일을 .env.local 로 복사해서 값을 채우세요. (배포 시엔 호스팅 플랫폼 환경변수에 등록)
# NEXT_PUBLIC_ 접두사 = 브라우저 번들에 인라인됨 (빌드 시점에 필요).

# 카카오맵 JavaScript 키 — 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
# 콘솔 > 앱 설정 > 플랫폼 > Web 에 배포 도메인(예: https://date-log.vercel.app)도 등록해야 지도가 뜸
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 카카오 로컬 REST API 키 — 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키
# (위 JavaScript 키와 다른 키!) 서버 전용(Route Handler)에서 장소 후보 검색에 사용.
# NEXT_PUBLIC_ 아님 — 브라우저 번들에 포함되지 않음.
KAKAO_REST_API_KEY=

# Supabase — 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 인증(이메일/Google OAuth)은 Supabase 대시보드에서 설정하며 앱 환경변수가 필요 없다.
# service_role 키 / Google Client Secret 등 서버 비밀값은 여기에 두지 않는다.

# OpenAI API 키 — platform.openai.com > API keys.
# 서버 전용(Route Handler)에서만 읽는다. NEXT_PUBLIC_ 접두사가 아니므로 브라우저 번들에
# 절대 포함되지 않는다. 로컬은 .env.local, 배포는 Vercel 서버 환경변수에만 등록.
OPENAI_API_KEY=
